# LingAI Backend Configuration
# Copy this file to .env and fill in your values
# ⚠️ 禁止在本文件中写入真实密码或密钥

# Server
HOST=127.0.0.1
PORT=18000
DEBUG=true

# Deepseek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud Qwen (Backup LLM)
QWEN_API_KEY=your_qwen_api_key_here

# Alibaba Cloud TTS
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_TTS_APP_KEY=your_tts_app_key
ALIYUN_VOICE_KO=xiaoyun
ALIYUN_VOICE_ZH=xiaoyun

# Data paths
DATA_DIR=./data
AUDIO_CACHE_DIR=./data/audio_cache

# Redis：仅指向专属本地实例；不使用公共开发实例
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_PREFIX=lingai-lg020
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# API Timeouts (seconds)
LLM_TIMEOUT=20
TTS_TIMEOUT=10

# TTS Provider：本地显式使用 edge；aliyun 需可用凭据与音色权限
TTS_PROVIDER=edge
TTS_FALLBACK_ENABLED=false

# TTS Redis Cache
TTS_REDIS_TTL=604800
TTS_PRELOAD_ENABLED=false

# CORS（生产默认关闭，dev 按需开启，禁止使用 * 通配）
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
