# LingAI Backend Configuration
# Copy this file to .env and fill in your values
# ⚠️ 禁止在本文件中写入真实密码或密钥

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Deepseek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud Qwen (Backup LLM)
QWEN_API_KEY=your_qwen_api_key_here

# Alibaba Cloud TTS
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_TTS_APP_KEY=your_tts_app_key
ALIYUN_VOICE_KO=xiaoyun
ALIYUN_VOICE_ZH=xiaoyun

# Data paths
DATA_DIR=./data
AUDIO_CACHE_DIR=./data/audio_cache

# Redis（生产环境必须注入带密码的完整 URL）
REDIS_URL=redis://localhost:6379/0

# API Timeouts (seconds)
LLM_TIMEOUT=20
TTS_TIMEOUT=10

# TTS Provider（aliyun = 阿里云主链路 | edge = Edge TTS 开发模式）
TTS_PROVIDER=aliyun
TTS_FALLBACK_ENABLED=true

# TTS Redis Cache
TTS_REDIS_TTL=604800
TTS_PRELOAD_ENABLED=true
